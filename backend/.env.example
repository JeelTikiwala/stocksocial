# ---- Data store ----
# memory  = serve the deterministic mock market (no database needed; default when DATABASE_URL is unset)
# prisma  = serve ingested NSE EOD data from Postgres
DATA_STORE=memory

# PostgreSQL (required for prisma store and for account routes: auth, watchlist, settings, broker)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/delta"

# Authentication secrets (required for account routes)
JWT_SECRET="replace_with_a_strong_random_secret"
JWT_REFRESH_SECRET="replace_with_a_different_strong_random_secret"

# AES-256 key for encrypted broker credentials (64 hex characters)
ENCRYPTION_KEY="replace_with_64_hex_characters"

PORT=3000
NODE_ENV="development"

# Zerodha Kite Connect — ORDER EXECUTION ONLY. Kite terms forbid displaying its market data in third-party apps.
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""
ZERODHA_REDIRECT_URL="http://localhost:3000/v1/broker/zerodha/callback"

# ---- Live data (Phase B) ----
# simulated = synthetic ticks from the EOD dataset (default; works when the market is closed)
# kite      = Zerodha Kite Connect for YOUR OWN account (Kite terms: personal consumption only)
# off       = no live feed
LIVE_PROVIDER=simulated

# Kite Connect app (https://developers.kite.trade). Redirect URL in the Kite app must equal KITE_REDIRECT_URL.
KITE_API_KEY=""
KITE_API_SECRET=""
KITE_REDIRECT_URL="http://localhost:3000/v1/live/kite/callback"
