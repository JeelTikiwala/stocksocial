# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stocksocial

# Generate two independent values with: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-secret

# Must be exactly 64 hexadecimal characters. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

# Server
PORT=3000
NODE_ENV=development

# Optional market-data provider. The backend uses its limited demo key if empty.
ALPHA_VANTAGE_API_KEY=

# Optional prototype Zerodha integration
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URL=http://localhost:3000/v1/broker/zerodha/callback
