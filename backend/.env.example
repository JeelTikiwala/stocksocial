# PostgreSQL connection (required)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/stockcircle"

# Authentication secrets (required; replace with strong random values)
JWT_SECRET="replace_with_a_strong_random_secret"
JWT_REFRESH_SECRET="replace_with_a_different_strong_random_secret"

# AES-256 key for encrypted broker credentials (required; 64 hex characters)
ENCRYPTION_KEY="replace_with_64_hex_characters"

# Optional market-data integration
ALPHA_VANTAGE_API_KEY="demo"

# Server configuration
PORT=3000
NODE_ENV="development"

# Optional Zerodha integration
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""
ZERODHA_REDIRECT_URL="http://localhost:3000/v1/broker/zerodha/callback"
