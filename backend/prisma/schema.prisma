// Prisma schema for Delta (India F&O analytics)

generator client {
  provider      = "prisma-client-js"
  // Dev machines here run both x64 (Rosetta) and arm64 Node; ship engines for both.
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Accounts ----------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  isVerified   Boolean  @default(false)
  isPro        Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brokerConnections BrokerConnection[]
  holdings          Holding[]
  trades            Trade[]
  watchlists        Watchlist[]
  settings          UserSettings?

  @@index([username])
  @@index([email])
}

model BrokerConnection {
  id           String    @id @default(cuid())
  userId       String
  broker       Broker
  accessToken  String    // AES-256 encrypted
  refreshToken String?
  expiresAt    DateTime?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, broker])
  @@index([userId])
}

/// ZERODHA = order execution only (Kite terms forbid displaying its market data in third-party apps).
/// UPSTOX / FYERS / ANGELONE / DHAN = per-user data connections for Phase B (BYOB).
enum Broker {
  ZERODHA
  GROWW
  UPSTOX
  FYERS
  ANGELONE
  DHAN
}

model Holding {
  id             String   @id @default(cuid())
  userId         String
  ticker         String
  companyName    String
  exchange       String
  quantity       Float
  avgBuyPrice    Float
  currentPrice   Float
  todayChangePct Float    @default(0)
  allocationPct  Float    @default(0)
  colorHex       String
  lastSyncedAt   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker, exchange])
  @@index([userId])
}

model Trade {
  id         String    @id @default(cuid())
  userId     String
  ticker     String
  type       TradeType
  quantity   Float
  price      Float
  executedAt DateTime
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticker])
  @@index([executedAt])
}

enum TradeType {
  BUY
  SELL
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  isPublic  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  ticker      String
  exchange    String   @default("NSE")
  addedAt     DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, ticker])
  @@index([ticker])
}

model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  portfolioGoal           Float?
  dividendGoalMonthly     Float?
  pushNotifications       Boolean  @default(true)
  earningsNotifications   Boolean  @default(true)
  priceAlertNotifications Boolean  @default(true)
  weeklyDigestEnabled     Boolean  @default(true)
  theme                   String   @default("light")
  currency                String   @default("INR")
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------- Market data (EOD, from free NSE files) ----------------

/// One row per F&O contract per trading day — normalised NSE UDiFF bhavcopy.
model FoContractEod {
  id              String   @id @default(cuid())
  tradeDate       DateTime
  symbol          String
  instrumentType  String   // IDO | STO | IDF | STF
  expiry          DateTime
  strike          Float?
  optionType      String?  // CE | PE
  open            Float
  high            Float
  low             Float
  close           Float
  last            Float
  prevClose       Float
  underlyingPrice Float
  settle          Float
  oi              Float    // units (shares), as NSE reports — exceeds INT4 for low-priced names
  chgOi           Float
  volume          Float    // units
  turnover        Float
  trades          Int
  lotSize         Int

  @@index([tradeDate])
  @@index([symbol, tradeDate])
  @@index([tradeDate, symbol, expiry])
}

model UnderlyingEod {
  tradeDate      DateTime
  symbol         String
  close          Float
  prevClose      Float
  futVolume      Float
  futVolumeAvg20 Float?
  isIndex        Boolean
  sector         String

  @@id([tradeDate, symbol])
  @@index([symbol])
}

model IndexEod {
  tradeDate DateTime
  name      String
  close     Float
  prevClose Float

  @@id([tradeDate, name])
}

/// Near-expiry ATM IV and straddle per underlying per day (computed at ingestion).
model IvDaily {
  tradeDate     DateTime
  symbol        String
  expiry        DateTime
  atmIv         Float?
  atmStrike     Float
  straddlePrice Float
  spot          Float
  daysToExpiry  Int

  @@id([tradeDate, symbol])
  @@index([symbol])
}

model FiiDiiDaily {
  tradeDate DateTime @id
  fiiNet    Float
  diiNet    Float
}

model UniverseSymbol {
  symbol    String   @id
  name      String
  sector    String
  isIndex   Boolean
  lotSize   Int
  updatedAt DateTime @updatedAt
}

model IngestionRun {
  id         String    @id @default(cuid())
  tradeDate  DateTime
  source     String
  status     String    // running | success | failed
  rows       Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([tradeDate])
}
