// Prisma schema for StockCircle

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  displayName  String?
  bio          String?
  avatarUrl    String?
  isVerified   Boolean  @default(false)
  isPro        Boolean  @default(false)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brokerConnections BrokerConnection[]
  holdings          Holding[]
  trades            Trade[]
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  followers         Follow[]           @relation("following")
  following         Follow[]           @relation("follower")
  savedPosts        SavedPost[]
  watchlists        Watchlist[]
  stockInteractions StockInteraction[]
  activities        UserActivity[]
  settings          UserSettings?

  @@index([username])
  @@index([email])
}

model BrokerConnection {
  id           String    @id @default(cuid())
  userId       String
  broker       Broker
  accessToken  String    // AES-256 encrypted
  refreshToken String?
  expiresAt    DateTime?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, broker])
  @@index([userId])
}

enum Broker {
  ZERODHA
  GROWW
  UPSTOX
}

model Holding {
  id            String   @id @default(cuid())
  userId        String
  ticker        String
  companyName   String
  exchange      String
  quantity      Float
  avgBuyPrice   Float
  currentPrice  Float
  todayChangePct Float   @default(0)
  allocationPct Float    @default(0)
  colorHex      String
  lastSyncedAt  DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker, exchange])
  @@index([userId])
}

model Trade {
  id         String    @id @default(cuid())
  userId     String
  ticker     String
  type       TradeType
  quantity   Float
  price      Float
  executedAt DateTime
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticker])
  @@index([executedAt])
}

enum TradeType {
  BUY
  SELL
}

model Post {
  id             String    @id @default(cuid())
  userId         String
  content        String
  title          String?
  attachedTicker String?
  imageUrl       String?
  likeCount      Int       @default(0)
  commentCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   Comment[]
  likes      Like[]
  savedBy    SavedPost[]

  @@index([userId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model MarketEvent {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  dateTime  DateTime
  type      EventType
  imageUrl  String?
  createdAt DateTime  @default(now())

  @@index([dateTime])
}

enum EventType {
  WEBINAR
  IPO
  EARNINGS
  DIVIDEND
}

model EarningsReport {
  id          String   @id @default(cuid())
  ticker      String
  companyName String
  reportDate  DateTime
  exchange    String
  createdAt   DateTime @default(now())

  @@index([reportDate])
  @@index([ticker])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Watchlist for tracking stocks users are watching
model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  isPublic  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  ticker      String
  exchange    String   @default("NSE")
  addedAt     DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, ticker])
  @@index([ticker])
  @@index([addedAt])
}

// Track user interactions with stocks for analytics and activity feed
model StockInteraction {
  id        String   @id @default(cuid())
  userId    String
  ticker    String
  action    String   // 'view', 'search', 'watchlist_add', 'share', etc.
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticker])
  @@index([createdAt])
}

// Social activity feed for tracking user actions
model UserActivity {
  id          String       @id @default(cuid())
  userId      String
  type        ActivityType
  ticker      String?
  targetUserId String?     // For follow activities
  postId      String?      // For post-related activities
  metadata    String?      // JSON string for additional data
  isPublic    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([ticker])
}

enum ActivityType {
  WATCHLIST_ADD
  WATCHLIST_REMOVE
  TRADE_BUY
  TRADE_SELL
  POST_CREATE
  POST_LIKE
  FOLLOW_USER
  GOAL_REACHED
  PORTFOLIO_MILESTONE
}

// User settings stored server-side
model UserSettings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  portfolioGoal          Float?
  dividendGoalMonthly    Float?
  pushNotifications      Boolean  @default(true)
  earningsNotifications  Boolean  @default(true)
  socialNotifications    Boolean  @default(true)
  priceAlertNotifications Boolean @default(true)
  weeklyDigestEnabled    Boolean  @default(true)
  privacyShowHoldings    Boolean  @default(true)
  privacyShowTrades      Boolean  @default(false)
  privacyShowActivity    Boolean  @default(true)
  theme                  String   @default("light")
  currency               String   @default("INR")
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
