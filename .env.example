# Express API used by the Expo app.
# Use 10.0.2.2 instead of localhost for the Android Emulator.
# Use your computer's LAN IP when testing on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# Optional external trading sidecar. Its server is not included in this repo.
# EXPO_PUBLIC_TRADING_API_URL=http://127.0.0.1:8765
